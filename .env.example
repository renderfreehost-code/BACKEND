PORT=3000
TOKEN_SECRET=change-this-long-random-secret

# Optional Neon/Postgres database. If empty, the app uses data/app-data.json locally.
DATABASE_URL=

# Optional Google login. Create OAuth client in Google Cloud and paste the web client id.
GOOGLE_CLIENT_ID=

# Optional comma separated origins for production CORS-like checks if you proxy APIs.
APP_ORIGIN=
